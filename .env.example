# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=

# Google Search Console HTML meta verification token
VITE_GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools HTML meta verification token (msvalidate.01)
VITE_BING_SITE_VERIFICATION=

# Product Hunt post id for the featured/upvote badge (shows after launch)
VITE_PRODUCT_HUNT_POST_ID=

# Optional Product Hunt post slug for the badge link (defaults to post id)
VITE_PRODUCT_HUNT_POST_SLUG=
